# Copy this file to .env and fill in values.
# .env is gitignored and must never be committed.

# Directory containing the source DuckDB databases. The notebook attaches
# country_info.duckdb, inflation.duckdb, fao.duckdb, commodity_prices.duckdb,
# effective_exchange_rates.duckdb and exchange_rates.duckdb from this path.
#
# These databases are not distributed with the repository. See the "Data"
# section of the README for the underlying sources and how to rebuild them.
DUCKDB_DIR=/path/to/duckdb/databases
